# InsForge public client configuration
NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# AI provider configuration
# "vercel-ai-google" uses the Vercel AI Gateway (billed to your Vercel credits)
# "gemini" uses the legacy @google/genai SDK directly
AI_PROVIDER=vercel-ai-google
# Model string as shown in the Vercel AI Gateway catalog
# See: https://vercel.com/docs/ai/ai-gateway#supported-models
AI_MODEL=deepseek/deepseek-v4-flash-0731

# ImageKit public delivery endpoint
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# Stripe billing configuration (server-side)
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Get from Stripe dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
# Create recurring prices in Stripe dashboard → Products, then paste the price IDs here
STRIPE_MONTHLY_PRICE_ID=price_...
STRIPE_YEARLY_PRICE_ID=price_...
INSFORGE_ADMIN_KEY=

# App URL used for billing redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional InsForge storage bucket overrides
NEXT_PUBLIC_INSFORGE_EXPORTS_BUCKET=theme-exports
NEXT_PUBLIC_INSFORGE_THUMBNAILS_BUCKET=project-thumbnails
